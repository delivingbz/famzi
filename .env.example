DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Used only once to verify access while creating the first admin account.
ADMIN_PASSWORD="replace-with-a-long-random-password"
# Generate a random secret of at least 32 characters for signing admin sessions.
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Resend sends admin email verification and password reset links.
RESEND_API_KEY="re_..."
# Use a sender address on a domain verified in your Resend account.
ADMIN_EMAIL_FROM="FAMZI Admin <admin@your-verified-domain.com>"
# Optional compatibility fallback used when ADMIN_EMAIL_FROM is empty.
ADMIN_RESET_EMAIL_FROM="FAMZI Admin <admin@your-verified-domain.com>"
# Public address placed into email links; use localhost only for local testing.
APP_URL="https://your-domain.com"
# Business WhatsApp number with country code and digits only.
WHATSAPP_BUSINESS_NUMBER=""
# Meta WhatsApp Cloud API credentials for opted-in order status updates.
# Create an approved utility template with three body placeholders: customer name, order ID, status.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION=""
WHATSAPP_ORDER_STATUS_TEMPLATE="order_status_update"
WHATSAPP_ORDER_STATUS_LANGUAGE="en"
