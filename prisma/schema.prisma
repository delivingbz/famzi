generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id           Int         @id @default(autoincrement())
  orderId      String      @unique
  customerName String
  phone        String
  address      String
  note         String?
  subtotal     Int
  deliveryFee  Int
  total        Int
  status       String      @default("Received")
  createdAt    DateTime    @default(now())
  items        OrderItem[]
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   Int
  menuItemId Int
  name      String
  price     Int
  quantity  Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}